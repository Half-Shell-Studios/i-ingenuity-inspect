{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "qa": {
      "distribution": "internal",
	  "env": {
		"EXPO_PUBLIC_API_URL": "https://beta.i-ingenuity.com/api/v1"
	  },
      "ios": {
        "simulator": false
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
	  "env": {
		"EXPO_PUBLIC_API_URL": "https://beta.i-ingenuity.com/api/v1"
	  }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development"
    }
  },
  "submit": {
    "production": {}
  }
}
